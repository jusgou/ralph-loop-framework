#!/bin/bash
# Nelson Scaffold - Set up Nelson Loop framework in a project
# Usage: nelson-scaffold [toro|plan-build|both] [target_directory]

set -e

TEMPLATES_DIR="$HOME/.nelson-template"
MODE="${1:-both}"
TARGET_DIR="${2:-.}"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_header() {
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}  Nelson Scaffold - Initialize Nelson Loop Framework     ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_info() {
    echo -e "${BLUE}→${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}!${NC} $1"
}

scaffold_toro() {
    local target="$1"
    local nelson_dir="$target/.ralph"

    print_info "Setting up toro/ralph mode..."

    # Create .ralph directory
    mkdir -p "$nelson_dir"

    # Copy templates
    cp "$TEMPLATES_DIR/toro/nelson.sh" "$nelson_dir/"
    cp "$TEMPLATES_DIR/toro/CLAUDE.md" "$nelson_dir/"
    cp "$TEMPLATES_DIR/toro/prd.json.example" "$nelson_dir/"

    # Make executable
    chmod +x "$nelson_dir/nelson.sh"

    # Create initial files
    if [ ! -f "$nelson_dir/prd.json" ]; then
        print_info "Creating initial prd.json..."
        cat > "$nelson_dir/prd.json" <<'EOF'
{
  "project": "PROJECT_NAME",
  "branchName": "nelson/initial",
  "description": "Initial Nelson setup",
  "userStories": [
    {
      "id": "US-001",
      "title": "Setup complete",
      "description": "As a developer, I want to verify Nelson is configured correctly.",
      "acceptanceCriteria": [
        ".nelson/nelson.sh is executable",
        ".nelson/CLAUDE.md exists",
        ".nelson/prd.json is valid JSON"
      ],
      "priority": 1,
      "passes": false,
      "notes": ""
    }
  ]
}
EOF
    fi

    if [ ! -f "$nelson_dir/progress.txt" ]; then
        echo "# Nelson Progress Log" > "$nelson_dir/progress.txt"
        echo "Started: $(date)" >> "$nelson_dir/progress.txt"
        echo "---" >> "$nelson_dir/progress.txt"
    fi

    print_success "Toro mode configured"
    print_info "Files created in .nelson/:"
    echo "  - nelson.sh (executable loop script)"
    echo "  - CLAUDE.md (instructions for Claude)"
    echo "  - prd.json (user stories)"
    echo "  - prd.json.example (reference)"
    echo "  - progress.txt (iteration log)"
}

scaffold_plan_build() {
    local target="$1"
    local nelson_dir="$target/.ralph"

    print_info "Setting up plan/build mode..."

    # Create .ralph directory
    mkdir -p "$nelson_dir"

    # Copy templates
    cp "$TEMPLATES_DIR/plan-build/loop.sh" "$nelson_dir/"
    cp "$TEMPLATES_DIR/plan-build/PROMPT_plan.md" "$nelson_dir/"
    cp "$TEMPLATES_DIR/plan-build/PROMPT_build.md" "$nelson_dir/"

    # Make executable
    chmod +x "$nelson_dir/loop.sh"

    # Create initial implementation plan if it doesn't exist
    if [ ! -f "$nelson_dir/@IMPLEMENTATION_PLAN.md" ]; then
        print_info "Creating initial @IMPLEMENTATION_PLAN.md..."
        cat > "$nelson_dir/@IMPLEMENTATION_PLAN.md" <<'EOF'
# Implementation Plan

## High Priority
- [ ] Initialize project structure
- [ ] Set up development environment

## Medium Priority
- [ ] Add core functionality

## Low Priority
- [ ] Documentation improvements

## Completed
- [x] Nelson framework scaffolded
EOF
    fi

    print_success "Plan/build mode configured"
    print_info "Files created in .nelson/:"
    echo "  - loop.sh (executable loop script)"
    echo "  - PROMPT_plan.md (planning mode instructions)"
    echo "  - PROMPT_build.md (build mode instructions)"
    echo "  - @IMPLEMENTATION_PLAN.md (task tracking)"
}

scaffold_agents_md() {
    local target="$1"
    local nelson_dir="$target/.ralph"

    mkdir -p "$nelson_dir"

    if [ ! -f "$nelson_dir/AGENTS.md" ]; then
        print_info "Creating AGENTS.md..."
        cp "$TEMPLATES_DIR/shared/AGENTS.md" "$nelson_dir/"
        print_success "AGENTS.md created in .nelson/"
    else
        print_warning "AGENTS.md already exists in .nelson/, skipping"
    fi
}

create_gitignore_entries() {
    local target="$1"
    local gitignore="$target/.gitignore"

    # Add Nelson-specific ignores if not already present
    if [ -f "$gitignore" ]; then
        if ! grep -q "# Nelson Loop" "$gitignore"; then
            print_info "Adding Nelson entries to .gitignore..."
            cat >> "$gitignore" <<'EOF'

# Nelson Loop
.nelson/progress.txt
.nelson/archive/
.nelson/.last-branch
EOF
            print_success ".gitignore updated"
        fi
    else
        print_info "Creating .gitignore with Nelson entries..."
        cat > "$gitignore" <<'EOF'
# Nelson Loop
.nelson/progress.txt
.nelson/archive/
.nelson/.last-branch
EOF
        print_success ".gitignore created"
    fi
}

# Main execution
print_header

# Validate target directory
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Target directory '$TARGET_DIR' does not exist"
    exit 1
fi

cd "$TARGET_DIR"
TARGET_DIR=$(pwd)

print_info "Target directory: $TARGET_DIR"
print_info "Mode: $MODE"
echo ""

# Scaffold based on mode
case "$MODE" in
    toro)
        scaffold_toro "$TARGET_DIR"
        scaffold_agents_md "$TARGET_DIR"
        create_gitignore_entries "$TARGET_DIR"
        ;;
    plan-build)
        scaffold_plan_build "$TARGET_DIR"
        scaffold_agents_md "$TARGET_DIR"
        create_gitignore_entries "$TARGET_DIR"
        ;;
    both)
        scaffold_toro "$TARGET_DIR"
        scaffold_plan_build "$TARGET_DIR"
        scaffold_agents_md "$TARGET_DIR"
        create_gitignore_entries "$TARGET_DIR"
        ;;
    *)
        echo "Error: Invalid mode '$MODE'. Use: toro, plan-build, or both"
        exit 1
        ;;
esac

echo ""
print_success "Nelson framework scaffolded successfully!"
echo ""
print_info "Next steps:"

if [ "$MODE" = "toro" ] || [ "$MODE" = "both" ]; then
    echo ""
    echo "  Toro/Nelson mode:"
    echo "    1. Generate PRD: nelson-prd-generator .nelson/prd.json"
    echo "       OR edit .nelson/prd.json with your user stories"
    echo "    2. Update .nelson/AGENTS.md with project-specific info"
    echo "    3. Run: .nelson/nelson.sh --tool claude 10"
fi

if [ "$MODE" = "plan-build" ] || [ "$MODE" = "both" ]; then
    echo ""
    echo "  Plan/Build mode:"
    echo "    1. Create specs/ directory with specifications"
    echo "    2. Update .nelson/PROMPT_plan.md with your project goal"
    echo "    3. Run planning: .nelson/loop.sh plan"
    echo "    4. Review .nelson/@IMPLEMENTATION_PLAN.md"
    echo "    5. Run building: .nelson/loop.sh 20"
fi

echo ""
