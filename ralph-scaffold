#!/bin/bash
# Ralph Scaffold - Set up Ralph Loop framework in a project
# Usage: ralph-scaffold [snarktank|plan-build|both] [target_directory]

set -e

TEMPLATES_DIR="$HOME/.ralph-templates"
MODE="${1:-both}"
TARGET_DIR="${2:-.}"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_header() {
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}  Ralph Scaffold - Initialize Ralph Loop Framework     ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_info() {
    echo -e "${BLUE}→${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}!${NC} $1"
}

scaffold_snarktank() {
    local target="$1"
    local ralph_dir="$target/.ralph"

    print_info "Setting up snarktank/ralph mode..."

    # Create .ralph directory
    mkdir -p "$ralph_dir"

    # Copy templates
    cp "$TEMPLATES_DIR/snarktank/ralph.sh" "$ralph_dir/"
    cp "$TEMPLATES_DIR/snarktank/CLAUDE.md" "$ralph_dir/"
    cp "$TEMPLATES_DIR/snarktank/prd.json.example" "$ralph_dir/"

    # Make executable
    chmod +x "$ralph_dir/ralph.sh"

    # Create initial files
    if [ ! -f "$ralph_dir/prd.json" ]; then
        print_info "Creating initial prd.json..."
        cat > "$ralph_dir/prd.json" <<'EOF'
{
  "project": "PROJECT_NAME",
  "branchName": "ralph/initial",
  "description": "Initial Ralph setup",
  "userStories": [
    {
      "id": "US-001",
      "title": "Setup complete",
      "description": "As a developer, I want to verify Ralph is configured correctly.",
      "acceptanceCriteria": [
        ".ralph/ralph.sh is executable",
        ".ralph/CLAUDE.md exists",
        ".ralph/prd.json is valid JSON"
      ],
      "priority": 1,
      "passes": false,
      "notes": ""
    }
  ]
}
EOF
    fi

    if [ ! -f "$ralph_dir/progress.txt" ]; then
        echo "# Ralph Progress Log" > "$ralph_dir/progress.txt"
        echo "Started: $(date)" >> "$ralph_dir/progress.txt"
        echo "---" >> "$ralph_dir/progress.txt"
    fi

    print_success "Snarktank mode configured"
    print_info "Files created in .ralph/:"
    echo "  - ralph.sh (executable loop script)"
    echo "  - CLAUDE.md (instructions for Claude)"
    echo "  - prd.json (user stories)"
    echo "  - prd.json.example (reference)"
    echo "  - progress.txt (iteration log)"
}

scaffold_plan_build() {
    local target="$1"
    local ralph_dir="$target/.ralph"

    print_info "Setting up plan/build mode..."

    # Create .ralph directory
    mkdir -p "$ralph_dir"

    # Copy templates
    cp "$TEMPLATES_DIR/plan-build/loop.sh" "$ralph_dir/"
    cp "$TEMPLATES_DIR/plan-build/PROMPT_plan.md" "$ralph_dir/"
    cp "$TEMPLATES_DIR/plan-build/PROMPT_build.md" "$ralph_dir/"

    # Make executable
    chmod +x "$ralph_dir/loop.sh"

    # Create initial implementation plan if it doesn't exist
    if [ ! -f "$ralph_dir/@IMPLEMENTATION_PLAN.md" ]; then
        print_info "Creating initial @IMPLEMENTATION_PLAN.md..."
        cat > "$ralph_dir/@IMPLEMENTATION_PLAN.md" <<'EOF'
# Implementation Plan

## High Priority
- [ ] Initialize project structure
- [ ] Set up development environment

## Medium Priority
- [ ] Add core functionality

## Low Priority
- [ ] Documentation improvements

## Completed
- [x] Ralph framework scaffolded
EOF
    fi

    print_success "Plan/build mode configured"
    print_info "Files created in .ralph/:"
    echo "  - loop.sh (executable loop script)"
    echo "  - PROMPT_plan.md (planning mode instructions)"
    echo "  - PROMPT_build.md (build mode instructions)"
    echo "  - @IMPLEMENTATION_PLAN.md (task tracking)"
}

scaffold_agents_md() {
    local target="$1"
    local ralph_dir="$target/.ralph"

    mkdir -p "$ralph_dir"

    if [ ! -f "$ralph_dir/AGENTS.md" ]; then
        print_info "Creating AGENTS.md..."
        cp "$TEMPLATES_DIR/shared/AGENTS.md" "$ralph_dir/"
        print_success "AGENTS.md created in .ralph/"
    else
        print_warning "AGENTS.md already exists in .ralph/, skipping"
    fi
}

create_gitignore_entries() {
    local target="$1"
    local gitignore="$target/.gitignore"

    # Add Ralph-specific ignores if not already present
    if [ -f "$gitignore" ]; then
        if ! grep -q "# Ralph Loop" "$gitignore"; then
            print_info "Adding Ralph entries to .gitignore..."
            cat >> "$gitignore" <<'EOF'

# Ralph Loop
.ralph/progress.txt
.ralph/archive/
.ralph/.last-branch
EOF
            print_success ".gitignore updated"
        fi
    else
        print_info "Creating .gitignore with Ralph entries..."
        cat > "$gitignore" <<'EOF'
# Ralph Loop
.ralph/progress.txt
.ralph/archive/
.ralph/.last-branch
EOF
        print_success ".gitignore created"
    fi
}

# Main execution
print_header

# Validate target directory
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Target directory '$TARGET_DIR' does not exist"
    exit 1
fi

cd "$TARGET_DIR"
TARGET_DIR=$(pwd)

print_info "Target directory: $TARGET_DIR"
print_info "Mode: $MODE"
echo ""

# Scaffold based on mode
case "$MODE" in
    snarktank)
        scaffold_snarktank "$TARGET_DIR"
        scaffold_agents_md "$TARGET_DIR"
        create_gitignore_entries "$TARGET_DIR"
        ;;
    plan-build)
        scaffold_plan_build "$TARGET_DIR"
        scaffold_agents_md "$TARGET_DIR"
        create_gitignore_entries "$TARGET_DIR"
        ;;
    both)
        scaffold_snarktank "$TARGET_DIR"
        scaffold_plan_build "$TARGET_DIR"
        scaffold_agents_md "$TARGET_DIR"
        create_gitignore_entries "$TARGET_DIR"
        ;;
    *)
        echo "Error: Invalid mode '$MODE'. Use: snarktank, plan-build, or both"
        exit 1
        ;;
esac

echo ""
print_success "Ralph framework scaffolded successfully!"
echo ""
print_info "Next steps:"

if [ "$MODE" = "snarktank" ] || [ "$MODE" = "both" ]; then
    echo ""
    echo "  Snarktank/Ralph mode:"
    echo "    1. Generate PRD: ralph-prd-generator .ralph/prd.json"
    echo "       OR edit .ralph/prd.json with your user stories"
    echo "    2. Update .ralph/AGENTS.md with project-specific info"
    echo "    3. Run: .ralph/ralph.sh --tool claude 10"
fi

if [ "$MODE" = "plan-build" ] || [ "$MODE" = "both" ]; then
    echo ""
    echo "  Plan/Build mode:"
    echo "    1. Create specs/ directory with specifications"
    echo "    2. Update .ralph/PROMPT_plan.md with your project goal"
    echo "    3. Run planning: .ralph/loop.sh plan"
    echo "    4. Review .ralph/@IMPLEMENTATION_PLAN.md"
    echo "    5. Run building: .ralph/loop.sh 20"
fi

echo ""
